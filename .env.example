# Firebase client configuration. Vite exposes only VITE_ variables to the browser.
# The Firebase web API key identifies this app; it is not an admin credential.
VITE_FIREBASE_ENABLED="true"
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Enable only after Anonymous Authentication is enabled in Firebase Console.
# When disabled or unavailable, the repository safely retains local browser fallback data.
VITE_FIREBASE_ENABLE_ANONYMOUS_AUTH="false"

# Server-only Razorpay settings. Empty until the account owner supplies keys.
# Never prefix secrets with VITE_. Key ID is returned by the trusted server.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Protected expiry/reconciliation scheduler; invoke at least every minute.
CRON_SECRET=
# Production: true. Preview/Development: false. VERCEL_ENV is supplied by Vercel.
PAYMENTS_LIVE_ENABLED=false

# Required Production identity pins. Match the existing Firebase client config.
FIREBASE_PRODUCTION_PROJECT_ID=
FIREBASE_PRODUCTION_WEB_API_KEY=
# OPTIONAL for Production. Leave empty until a separate safe project exists.
# Connected Preview/Development requires BOTH Test pins, distinct from Production,
# and the full Test client/Admin config. Never copy Production credentials there.
FIREBASE_TEST_PROJECT_ID=
FIREBASE_TEST_WEB_API_KEY=

# Server-only service account for the selected Firebase project.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# See PAYMENT_ENVIRONMENTS.md. Unconfigured local builds disable Firebase.

# Existing secure upload configuration, independent of Razorpay.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Vercel Firebase Admin runtime; preserve any other required Node options.
NODE_OPTIONS=--experimental-require-module
