# Firebase client configuration. Vite exposes only VITE_ variables to the browser.
# The Firebase web API key identifies this app; it is not an admin credential.
VITE_FIREBASE_ENABLED="true"
VITE_FIREBASE_API_KEY="AIzaSyBJ37iefm5GngQIvsAYJKLK56ne3Tl-3bU"
VITE_FIREBASE_AUTH_DOMAIN="boutique-79308.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="boutique-79308"
VITE_FIREBASE_STORAGE_BUCKET="boutique-79308.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="801247122958"
VITE_FIREBASE_APP_ID="1:801247122958:web:cf6a588faefe8cf8a90e5f"

# Enable only after Anonymous Authentication is enabled in Firebase Console.
# When disabled or unavailable, the repository safely retains local browser fallback data.
VITE_FIREBASE_ENABLE_ANONYMOUS_AUTH="false"

# Server-only Razorpay settings. Empty until the account owner supplies keys.
# Never prefix secrets with VITE_. Key ID is returned by the trusted server.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Protected expiry/reconciliation scheduler; invoke at least every minute.
CRON_SECRET=
# Live keys additionally require VERCEL_ENV=production; leave empty for test mode.
PAYMENTS_LIVE_ENABLED=
