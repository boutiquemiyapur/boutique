rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // This claim must be assigned only with the Firebase Admin SDK or a trusted
    // Cloud Function. It is never read from a client-writable Firestore field.
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function owns(userId) { return signedIn() && request.auth.uid == userId; }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    // Coupon codes are public only because the present storefront validates a
    // code in-browser. A checkout function must still recalculate eligibility.
    match /coupons/{couponId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /banners/{bannerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /siteContent/{contentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /about/{aboutId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /contact/{contactId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    // Public visitors may submit a tightly validated enquiry, but only a
    // custom-claim admin may ever read, change, or delete it.
    match /contactMessages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'message', 'status', 'source', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['name', 'email', 'message', 'status', 'source', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 160
        && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 2000
        && (!request.resource.data.keys().hasAny(['phone']) || (request.resource.data.phone is string && request.resource.data.phone.size() <= 30))
        && request.resource.data.status == 'new'
        && request.resource.data.source == 'contact_form'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow read, update, delete: if isAdmin();
    }
    match /customers/{customerId} {
      allow read, write: if isAdmin();
    }

    // Canonical customer order records. New orders are written only here;
    // the nested user orders below remain read-compatible with older data.
    match /orders/{orderId} {
      allow read: if isAdmin() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow create: if isAdmin() || (signedIn()
        && request.resource.data.keys().hasOnly(['customerId', 'orderNumber', 'paymentStatus', 'orderStatus', 'data', 'createdAt', 'updatedAt'])
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.orderNumber is string
        && request.resource.data.paymentStatus == 'Pending'
        && request.resource.data.orderStatus == 'Order Placed'
        && request.resource.data.data.id == orderId
        && request.resource.data.data.orderNumber == request.resource.data.orderNumber
        && request.resource.data.data.paymentMethod == 'cod'
        && request.resource.data.data.paymentStatus == 'Pending'
        && request.resource.data.data.orderStatus == 'Order Placed'
        && request.resource.data.data.items is list
        && request.resource.data.data.items.size() > 0
        && request.resource.data.data.shippingAddress.fullName is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time);
      // Customers cannot alter submitted orders. Fulfilment changes are
      // limited to the Firebase Authentication admin custom claim.
      allow update, delete: if isAdmin();
    }

    // `collectionGroup('orders')` is used by the admin dashboard to read the
    // customer-owned order documents below. Collection-group queries require
    // an explicit version-2 recursive match; this grants read access only to
    // Firebase Authentication tokens bearing the trusted admin custom claim.
    match /{path=**}/orders/{orderId} {
      allow read: if isAdmin();
    }

    match /users/{userId} {
      allow read: if owns(userId) || isAdmin();
      allow create: if owns(userId)
        && request.resource.data.keys().hasOnly(['profile', 'role', 'createdAt', 'updatedAt'])
        && request.resource.data.role == 'customer';
      allow update: if isAdmin() || (
        owns(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['profile', 'updatedAt'])
      );
      allow delete: if false;

      // Private customer checkout requests. Only a server process may update
      // payment, fulfilment, tracking, prices, discount, or stock outcomes.
      match /orders/{orderId} {
        allow read: if owns(userId) || isAdmin();
        // Legacy documents are retained for customer/admin reads and an
        // idempotent client-side compatibility migration. New checkout writes
        // are intentionally not permitted in this non-canonical path.
        allow create: if false;
        allow update, delete: if isAdmin();
      }
    }

    match /carts/{userId} {
      allow read: if owns(userId) || isAdmin();
      allow create: if owns(userId)
        && request.resource.data.keys().hasOnly(['ownerId', 'items', 'updatedAt'])
        && request.resource.data.ownerId == userId;
      allow update: if isAdmin() || (
        owns(userId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['items', 'updatedAt'])
      );
      allow delete: if owns(userId) || isAdmin();
    }

    match /wishlists/{userId} {
      allow read: if owns(userId) || isAdmin();
      allow create: if owns(userId)
        && request.resource.data.keys().hasOnly(['ownerId', 'productIds', 'updatedAt'])
        && request.resource.data.ownerId == userId;
      allow update: if isAdmin() || (
        owns(userId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['productIds', 'updatedAt'])
      );
      allow delete: if owns(userId) || isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.verifiedBuyer == false;
      allow update: if isAdmin() || (
        owns(resource.data.userId)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.productId == resource.data.productId
        && request.resource.data.verifiedBuyer == resource.data.verifiedBuyer
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['data', 'updatedAt'])
      );
      allow delete: if owns(resource.data.userId) || isAdmin();
    }
  }
}
