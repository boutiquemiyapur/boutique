{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test:sale-campaigns": "node --import tsx --test scripts/sale-campaigns.test.ts scripts/sale-campaigns-api.test.mjs",
    "test:sale-campaigns-browser": "node scripts/sale-campaigns-browser.test.mjs",
    "test:product-pricing": "node --import tsx --test scripts/product-pricing.test.ts",
    "test:product-pricing-browser": "node scripts/product-pricing-browser.test.mjs",
    "test:refund-management": "node --import tsx --test scripts/refund-management.test.ts scripts/refund-management-api.test.mjs scripts/refund-management-ui.test.mjs scripts/refund-management-client.test.mjs scripts/manual-refund-provider.test.mjs",
    "test:payment-security": "node --import tsx --test scripts/payment-security-audit.test.ts",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "node scripts/check-vercel-function-budget.mjs && vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:payments": "node --import tsx --test scripts/payment-foundation.test.ts scripts/payment-environment.test.ts",
    "test:payment-client": "node --test scripts/payment-client.test.mjs scripts/payment-presentation.test.mjs",
    "test:payment-emulator": "firebase emulators:exec --only firestore --project demo-ab-payments --config firebase.payments.test.json \"node scripts/payment-emulator-runner.mjs\"",
    "admin:grant": "node scripts/set-admin-claim.mjs",
    "admin:revoke": "node scripts/set-admin-claim.mjs --revoke",
    "test:cancellation-refunds": "node --import tsx --test scripts/cart-cancellation-refund.test.ts scripts/cancellation-api.test.mjs",
    "test:shopping-ux": "node scripts/shopping-ux.test.mjs",
    "test:payment-webhook": "node --test scripts/payment-webhook.test.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
